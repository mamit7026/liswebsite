<!-- Page Header -->
<div class="py-5 border-bottom" style="background: linear-gradient(135deg, var(--bg-light) 0%, #FFFFFF 100%);">
  <div class="container py-3">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a href="/" class="text-primary">Home</a></li>
        <li class="breadcrumb-item active text-muted">Privacy Policy</li>
      </ol>
    </nav>
    <div class="d-flex align-items-center gap-3 mb-2">
      <div class="brand-icon-box" style="width:44px;height:44px;font-size:1.3rem;"><i class="bi bi-shield-lock"></i></div>
      <h1 class="fw-bold mb-0 fs-2">Privacy Policy</h1>
    </div>
    <p class="text-muted mb-0 small">Last updated: <strong>October 1, 2026</strong> &bull; Applies to all LISDESK platform users</p>
