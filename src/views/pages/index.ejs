          </div>

          <!-- Live Pipeline Stats footer -->
          <div class="p-3 bg-light rounded-3 d-flex justify-content-around text-center border">
            <div>
              <div class="fw-bold fs-5 text-primary">88.4%</div>
              <div class="text-muted small" style="font-size: 0.75rem;">Auto-Verified</div>
            </div>
            <div class="border-end"></div>
            <div>
              <div class="fw-bold fs-5" style="color: var(--secondary);">24.6 min</div>
              <div class="text-muted small" style="font-size: 0.75rem;">Avg TAT Core Lab</div>
            </div>
            <div class="border-end"></div>
            <div>
              <div class="fw-bold fs-5 text-success">97.2%</div>
              <div class="text-muted small" style="font-size: 0.75rem;">Clean Claims</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

