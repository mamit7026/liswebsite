<!-- ==========================================================================
     Core Specialized Clinical Solutions
     ========================================================================== -->
<section class="section-padding">
  <div class="container">
    <div class="section-title-wrap">
      <span class="section-kicker">End-to-End Clinical Disciplines</span>
      <h2 class="section-title">Built for Every Laboratory Discipline</h2>
      <p class="section-lead">
        From multi-facility hospital core laboratories to high-throughput commercial reference labs and genomic sequencing centers.
      </p>
    </div>

    <div class="row g-4">
      <% if (typeof solutions !== 'undefined' && solutions && solutions.length > 0) { %>
        <% solutions.forEach(sol => { %>
          <div class="col-lg-4 col-md-6">
            <div class="omni-card">
              <div class="card-icon-wrap">
                <i class="bi <%= sol.icon || 'bi-capsule' %>"></i>
              </div>
              <div class="badge bg-light text-primary align-self-start mb-2 px-2 py-1 fw-semibold border" style="font-size: 0.75rem;">
                <%= sol.badgeText || sol.category %>
              </div>
              <h3 class="card-title"><%= sol.title %></h3>
              <p class="card-text"><%= sol.shortDesc %></p>

              <ul class="feature-check-list">
                <% (sol.keyFeatures || []).slice(0, 3).forEach(feat => { %>
                  <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span><%= feat %></span>
                  </li>
                <% }) %>
              </ul>

              <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                <a href="/solutions/<%= sol.slug %>" class="btn btn-sm btn-outline-omni">
                  Explore Module &rarr;
                </a>
                <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold p-0" data-bs-toggle="modal" data-bs-target="#demoModal">
                  Book Demo
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-4">
          <div class="p-4 bg-white rounded-4 border text-muted">
            <i class="bi bi-inbox fs-2 text-primary d-block mb-2"></i>
            <h5 class="fw-bold mb-1">Database Ready For Custom Solutions</h5>
            <p class="small text-muted mb-0">No static seed data attached. New clinical configurations can be added directly via database or REST API.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ==========================================================================
     Interactive 4-Stage Diagnostic Workflow Architecture
     ========================================================================== -->
<section class="section-padding bg-light" style="background-color: var(--bg-light) !important;">
  <div class="container">
    <div class="section-title-wrap">
      <span class="section-kicker">Unified Operating Architecture</span>
      <h2 class="section-title">The Complete Specimen Lifecycle</h2>
      <p class="section-lead">
        Replace disconnected point solutions with a single cohesive platform across all 4 operational phases.
      </p>
    </div>

    <!-- Nav tabs -->
    <div class="arch-tab-nav">
      <button class="arch-tab-btn active" data-target="phase1">
        <i class="bi bi-box-arrow-in-right"></i> 1. Pre-Analytical
      </button>
      <button class="arch-tab-btn" data-target="phase2">
        <i class="bi bi-cpu"></i> 2. Analytical &amp; QC
      </button>
      <button class="arch-tab-btn" data-target="phase3">
        <i class="bi bi-check2-all"></i> 3. Post-Analytical
      </button>
      <button class="arch-tab-btn" data-target="phase4">
        <i class="bi bi-cash-stack"></i> 4. Financial &amp; RCM
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="arch-showcase-box">
      <!-- Phase 1 -->
      <div class="arch-panel" id="phase1">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-primary text-white mb-2 px-3 py-1">PHASE 1: ORDER INTAKE &amp; ACCESSIONING</span>
            <h3 class="fw-bold mb-3">Positive Patient Identification &amp; 2D Barcoding</h3>
            <p class="text-muted mb-4">
              Prevent pre-analytical errors before the tube is uncapped. Orders placed via EHR (HL7 ORM / FHIR) or the physician web portal instantly generate unique 2D DataMatrix barcodes with real-time patient demographic and insurance validation.
            </p>
            <div class="row g-3">
              <div class="col-6">
                <div class="p-3 bg-light rounded border">
                  <div class="fw-bold text-primary"><i class="bi bi-phone me-1"></i> Mobile Phlebotomy</div>
                  <div class="small text-muted">Bedside wristband barcode verification</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 bg-light rounded border">
                  <div class="fw-bold text-teal" style="color: var(--secondary);"><i class="bi bi-truck me-1"></i> Courier Tracking</div>
                  <div class="small text-muted">Coolbox temperature and GPS transit logs</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="p-4 bg-dark text-white rounded-3 shadow">
              <div class="small text-uppercase text-secondary fw-bold mb-2">HL7 EHR Order Ingestion</div>
              <pre class="m-0 text-info font-monospace small" style="overflow-x: auto;">
MSH|^~\&|EPIC_EHR|METRO_HOSP|LISDESK|LAB_CORE|20261001123000||ORM^O01|MSG009812|P|2.5.1
PID|1||MRN984210^^^METRO||ANDERSON^JAMES^M||19820415|M
PV1|1|O|CLINIC_NORTH^^^ROOM102||||114920^DR_COLLINS
ORC|NW|ORD9021|||||^^^20261001123500|||20261001123000
OBR|1|ORD9021||80053^COMPREHENSIVE METABOLIC PANEL^CPT4|||20261001123200
&gt;&gt; [LISDESK Engine] Barcode: *CMP-984210* Assigned &bull; Specimen Verified</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 2 -->
      <div class="arch-panel d-none" id="phase2">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-info text-white mb-2 px-3 py-1">PHASE 2: ANALYZER DISPATCH &amp; WESTGARD QC</span>
            <h3 class="fw-bold mb-3">Bidirectional Host Query &amp; Real-Time QC</h3>
            <p class="text-muted mb-4">
              When the analyzer scans the tube barcode, LISDESK responds in &lt; 30ms with the exact test profile, automatic dilution ratio, and reflex rules. Levey-Jennings charts and multi-rule Westgard evaluations execute continuously to prevent out-of-control runs.
            </p>
            <div class="d-flex flex-column gap-2">
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded border">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <span class="small fw-semibold">Automatic analyzer lockout when QC violates 1:3s or 2:2s Westgard rules</span>
              </div>
              <div class="d-flex align-items-center gap-2 p-2 bg-light rounded border">
                <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                <span class="small fw-semibold">Automatic reflexing of abnormal findings to confirmatory panels</span>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="p-4 bg-white rounded-3 border shadow-sm">
              <h6 class="fw-bold mb-3"><i class="bi bi-graph-up text-primary me-2"></i>Levey-Jennings Real-Time Evaluation</h6>
              <div class="progress mb-2" style="height: 10px;">
                <div class="progress-bar bg-success" style="width: 70%"></div>
                <div class="progress-bar bg-warning" style="width: 25%"></div>
                <div class="progress-bar bg-danger" style="width: 5%"></div>
              </div>
              <div class="d-flex justify-content-between small text-muted mb-3">
                <span>Mean: 142.0 mEq/L</span>
                <span>SD: &plusmn; 1.2</span>
                <span class="text-success fw-bold">Westgard: PASSED</span>
              </div>
              <div class="p-2 bg-light rounded text-center small fw-semibold text-secondary">
                <i class="bi bi-check-circle-fill me-1"></i> Cobas 8000 Line 02 &bull; Active &amp; Verified
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 3 -->
      <div class="arch-panel d-none" id="phase3">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-secondary text-white mb-2 px-3 py-1">PHASE 3: AUTO-VERIFICATION &amp; SIGN-OUT</span>
            <h3 class="fw-bold mb-3">Algorithmic Decision Support in Milliseconds</h3>
            <p class="text-muted mb-4">
              Free your pathologists and senior technologists from repetitive normal reviews. Our rule engine cross-references patient age, gender, historical delta checks, and clinical ranges to verify 85%+ of tests instantly while routing critical values directly to pager/mobile alerts.
            </p>
            <ul class="feature-check-list">
              <li><i class="bi bi-check-circle-fill"></i> Delta checks against 365-day patient baseline history</li>
              <li><i class="bi bi-check-circle-fill"></i> CAP Cancer Protocol synoptic reporting for anatomic pathology</li>
              <li><i class="bi bi-check-circle-fill"></i> Instant SMS / secure email notification to attending physicians</li>
            </ul>
          </div>
          <div class="col-lg-6">
            <div class="p-4 bg-light rounded-3 border">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="fw-bold text-primary">Patient Cumulative Trend</span>
                <span class="badge bg-success">AUTO-VERIFIED</span>
              </div>
              <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white mb-0 small">
                  <thead class="table-light">
                    <tr>
                      <th>Analyte</th>
                      <th>Result</th>
                      <th>Ref Range</th>
                      <th>Delta</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td>Glucose</td>
                      <td class="fw-bold">94 mg/dL</td>
                      <td>70 - 99</td>
                      <td class="text-success">+2% (Normal)</td>
                    </tr>
                    <tr>
                      <td>Creatinine</td>
                      <td class="fw-bold">0.9 mg/dL</td>
                      <td>0.6 - 1.2</td>
                      <td class="text-success">0% (Stable)</td>
                    </tr>
                    <tr>
                      <td>Potassium</td>
                      <td class="fw-bold">4.2 mEq/L</td>
                      <td>3.5 - 5.0</td>
                      <td class="text-success">-1% (Normal)</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 4 -->
      <div class="arch-panel d-none" id="phase4">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-success text-white mb-2 px-3 py-1">PHASE 4: EMBEDDED RCM &amp; REVENUE CAPTURE</span>
            <h3 class="fw-bold mb-3">Stop Denials Before the Test is Performed</h3>
            <p class="text-muted mb-4">
              Unlike legacy architectures that bolt on third-party billing weeks after accessioning, LISDESK integrates real-time EDI 270/271 insurance eligibility, NCD/LCD medical necessity checking, and clean 837P/837I claim generation at the point of order.
            </p>
            <div class="p-3 bg-white rounded border mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <span class="fw-bold text-dark">Average Days in Accounts Receivable</span>
                <span class="fw-bold text-success fs-5">24.2 Days (vs 52 industry avg)</span>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="p-4 bg-dark text-white rounded-3 shadow">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="text-secondary small fw-bold text-uppercase">Automated Claim Scrubbing</span>
                <span class="badge bg-success">CLEAN CLAIM (100%)</span>
              </div>
              <div class="small font-monospace mb-2 text-muted">&gt; ANSI X12 837P Claim Scrubbing Active:</div>
              <div class="p-2 bg-black rounded small text-light font-monospace mb-2">
                CPT: 80053 (CMP) &bull; ICD-10: E11.9 (Type 2 Diabetes)<br>
                LCD Policy: L34002 Medical Necessity Matched &bull; Prior Auth: Verified
              </div>
              <div class="text-success small fw-semibold">
                <i class="bi bi-check-all me-1"></i> Auto-dispatched to Clearinghouse &bull; 0 Human Touches
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ==========================================================================
     Interactive Laboratory ROI & Turnaround Time Calculator
     ========================================================================== -->
<section class="section-padding">
  <div class="container">
    <div class="roi-card">
      <div class="row align-items-center">
        
        <div class="col-lg-5 mb-4 mb-lg-0">
          <span class="badge bg-secondary text-white mb-2 px-3 py-1 text-uppercase" style="letter-spacing: 0.1em; font-size: 0.72rem;">LABORATORY EFFICIENCY CALCULATOR</span>
          <h3 class="fw-bold text-white mb-3">Estimate Your Lab's Annual Savings</h3>
          <p class="text-light opacity-75 mb-4" style="font-size: 0.95rem;">
            See the projected impact of switching to LISDESK based on your laboratory's daily test volume and workflow automation.
          </p>

          <label for="testVolumeSlider" class="form-label text-white fw-bold mb-2">
            Average Daily Test Volume: <span id="volumeDisplay" class="text-info fw-bold ms-2">2,500 tests / day</span>
          </label>
          <input type="range" class="roi-slider mb-4" id="testVolumeSlider" min="500" max="15000" step="250" value="2500">

          <div class="d-flex gap-2">
            <button type="button" class="btn btn-secondary-omni" data-bs-toggle="modal" data-bs-target="#demoModal">
              Get Detailed ROI Report
            </button>
          </div>
        </div>

        <div class="col-lg-7">
          <div class="row g-3">
            <div class="col-md-4">
              <div class="roi-stat-box">
                <div class="roi-number" id="annualSavings">$194,500</div>
                <div class="text-white small fw-bold mt-2">Est. Annual Savings</div>
                <div class="text-muted small">Tech labor &amp; redraw elimination</div>
              </div>
            </div>
