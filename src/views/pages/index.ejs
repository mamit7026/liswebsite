<!-- ==========================================================================
     Hero Section with Live Specimen Visualizer
     ========================================================================== -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      
      <!-- Hero Copy -->
      <div class="col-lg-6 mb-5 mb-lg-0">
        <div class="hero-badge">
          <span class="pulse-dot"></span>
          <span>Next-Generation Diagnostics &bull; LISDESK 2026</span>
        </div>
        
        <h1 class="hero-title">
          The Intelligent <span class="hero-gradient-text">LIMS Platform</span> for Modern Diagnostic Labs
        </h1>
        
        <p class="hero-subtitle">
          LISDESK unifies high-throughput clinical chemistry, anatomic pathology, NGS genomics, and automated RCM billing — all in one enterprise-grade LIMS built for accuracy, speed, and compliance.
        </p>

        <div class="d-flex flex-wrap gap-3 mb-4">
          <button type="button" class="btn btn-primary-omni btn-lg" data-bs-toggle="modal" data-bs-target="#demoModal">
            <i class="bi bi-calendar-check-fill"></i> Schedule Live Demo
          </button>
          <a href="/solutions" class="btn btn-outline-omni btn-lg">
