<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- ==========================================================================
     Enterprise Hero Section with Interactive Workstation Console
     ========================================================================== -->
<section class="hero-section">
  <div class="container">
    <div class="row align-items-center">
      
      <!-- Left Column: Value Proposition -->
      <div class="col-lg-5 mb-5 mb-lg-0">
        <div class="hero-pill-badge">
          <span class="live-dot"></span>
          <span>LISDESK 2026 Enterprise Release</span>
        </div>
        
        <h1 class="hero-title">
          The Intelligent <span class="text-brand-accent">LIMS Platform</span> for Modern Diagnostic Laboratories
        </h1>
        
        <p class="hero-subtitle">
          Unify high-throughput clinical chemistry, anatomic pathology, NGS genomics, and automated RCM billing in a single, high-reliability platform built for compliance, speed, and precision.
        </p>

        <div class="d-flex flex-wrap gap-2 mb-4">
          <button type="button" class="btn btn-primary-omni" data-bs-toggle="modal" data-bs-target="#demoModal">
            <i class="bi bi-calendar-check-fill"></i> Schedule Live Demo
          </button>
          <a href="/solutions" class="btn btn-outline-omni">
            <i class="bi bi-diagram-3"></i> View Solutions
          </a>
        </div>

        <div class="hero-proof-list">
          <div class="hero-proof-item">
            <i class="bi bi-shield-check text-success"></i>
            <span>CAP / CLIA Certified</span>
          </div>
          <div class="hero-proof-item">
            <i class="bi bi-lightning-charge-fill text-primary"></i>
            <span>&lt; 5ms Auto-Verification</span>
          </div>
          <div class="hero-proof-item">
            <i class="bi bi-hdd-network text-teal" style="color: var(--secondary);"></i>
            <span>700+ Instrument Drivers</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Unified Enterprise Workstation Console -->
      <div class="col-lg-7">
        <div class="workstation-console">
          
          <!-- App Chrome Window Header -->
          <div class="console-header">
            <div class="console-window-dots">
              <span class="console-dot dot-red"></span>
              <span class="console-dot dot-yellow"></span>
              <span class="console-dot dot-green"></span>
            </div>
            <div class="console-title">
              <i class="bi bi-laptop me-1"></i> LISDESK Console &bull; Central Core Laboratory &bull; Station #04
            </div>
            <div>
              <span class="badge bg-primary px-2 py-1 font-mono" style="font-size: 0.68rem;">v2026.4.2</span>
            </div>
          </div>

          <!-- Console Toolbar / Workstation View Switcher -->
          <div class="console-toolbar">
            <div class="console-tabs" id="heroConsoleTabs">
              <button class="console-tab-btn active" data-view="lab">
                <i class="bi bi-broadcast text-info"></i> Automated Lab Feed
              </button>
              <button class="console-tab-btn" data-view="queue">
                <i class="bi bi-activity text-primary"></i> Specimen Queue
              </button>
              <button class="console-tab-btn" data-view="genomics">
                <i class="bi bi-dna text-purple" style="color: var(--purple);"></i> NGS Genomics
              </button>
              <button class="console-tab-btn" data-view="telemetry">
                <i class="bi bi-hdd-network text-success"></i> HL7/ASTM Hub
              </button>
            </div>
            <div>
              <span class="console-live-badge">
                <i class="bi bi-circle-fill" style="font-size: 0.5rem;"></i> ENGINE LIVE
              </span>
            </div>
          </div>

          <!-- Console Dynamic View Container -->
          <div class="console-view-container">
            
            <!-- View 1: High-Definition Lab Automation View (Default) -->
            <div class="console-view-panel" id="viewLab">
              <div class="lab-automation-screen">
                <img src="/public/image/hero-laboratory.jpg" alt="Clinical Diagnostic Laboratory Automation Track">
                <div class="lab-automation-hud">
                  <div class="d-flex justify-content-between align-items-start">
                    <span class="hud-pill">
                      <i class="bi bi-broadcast text-info"></i> Central Core Track Line 01 &bull; Active
                    </span>
                    <span class="hud-pill font-mono" style="color: #6EE7B7; border-color: rgba(110, 231, 183, 0.3);">
                      <i class="bi bi-check-circle-fill text-success me-1"></i> 700+ Instruments Linked
                    </span>
                  </div>
                  <div class="d-flex flex-wrap justify-content-between align-items-end gap-2">
                    <span class="hud-pill hud-pill-highlight">
                      <i class="bi bi-upc-scan text-white"></i> Positive 2D Patient ID &bull; SP-94821
                    </span>
                    <span class="hud-pill font-mono text-warning">
                      <i class="bi bi-lightning-charge me-1"></i> &lt; 5ms AutoVerify Engine
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- View 2: Specimen Queue Table View -->
            <div class="console-view-panel d-none" id="viewQueue">
              <div class="p-2">
                <div class="table-responsive">
                  <table class="specimen-table">
                    <thead>
                      <tr>
                        <th>Accession #</th>
                        <th>Patient / Demographic</th>
                        <th>Test Profile</th>
                        <th>Analyzer Line</th>
                        <th>Delta / Range</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody id="consoleSpecimenBody">
                      <!-- Populated dynamically via JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- View 3: NGS Genomics View -->
            <div class="console-view-panel d-none" id="viewGenomics">
              <div class="p-2">
                <div class="table-responsive">
                  <table class="specimen-table">
                    <thead>
                      <tr>
                        <th>Assay ID</th>
                        <th>Patient / Subject</th>
                        <th>Targeted Panel</th>
                        <th>Sequencer</th>
                        <th>Metric / Coverage</th>
                        <th>ACMG Status</th>
                      </tr>
                    </thead>
                    <tbody id="consoleGenomicsBody">
                      <!-- Populated dynamically via JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- View 4: HL7 / ASTM Telemetry Stream -->
            <div class="console-view-panel d-none" id="viewTelemetry">
              <div class="p-2">
                <div class="table-responsive">
                  <table class="specimen-table">
                    <thead>
                      <tr>
                        <th>Interface</th>
                        <th>Target System</th>
                        <th>Protocol / Stream</th>
                        <th>Socket / Port</th>
                        <th>Telemetry Latency</th>
                        <th>Connection</th>
                      </tr>
                    </thead>
                    <tbody id="consoleTelemetryBody">
                      <!-- Populated dynamically via JS -->
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

          </div>

          <!-- Console Footer Summary -->
          <div class="console-footer">
            <div class="console-stat-pill">
              <i class="bi bi-check-all text-success fs-6"></i>
              <span>Auto-Verified: <strong id="statAutoVerified">88.4%</strong></span>
            </div>
            <div class="console-stat-pill">
              <i class="bi bi-clock-history text-primary fs-6"></i>
              <span>Avg Core TAT: <strong>24.6 min</strong></span>
            </div>
            <div class="console-stat-pill d-none d-sm-flex">
              <i class="bi bi-file-earmark-check text-teal fs-6" style="color: var(--secondary);"></i>
              <span>Clean Claims: <strong>97.2%</strong></span>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<!-- ==========================================================================
     Key Metrics Ribbon
     ========================================================================== -->
<section class="metrics-ribbon">
  <div class="container">
    <div class="row g-4">
      <div class="col-6 col-lg-3 metric-item">
        <div class="metric-value counter-val" data-target="40" data-suffix="M+">40M+</div>
        <div class="metric-label">Patient Tests Annually</div>
        <div class="metric-sub">Processed with 99.99% high-availability uptime</div>
      </div>
      <div class="col-6 col-lg-3 metric-item">
        <div class="metric-value counter-val" data-target="88.4" data-suffix="%" data-decimals="1">88.4%</div>
        <div class="metric-label">Automated Verification Rate</div>
        <div class="metric-sub">Multi-rule clinical decision matrix &amp; delta checks</div>
      </div>
      <div class="col-6 col-lg-3 metric-item">
        <div class="metric-value counter-val" data-target="700" data-suffix="+">700+</div>
        <div class="metric-label">Bidirectional Analyzer Drivers</div>
        <div class="metric-sub">Native ASTM E1381/E1394, HL7 v2/v3, and FHIR</div>
      </div>
      <div class="col-6 col-lg-3 metric-item">
        <div class="metric-value counter-val" data-target="96.8" data-suffix="%" data-decimals="1">96.8%</div>
        <div class="metric-label">First-Pass Clean Claim Yield</div>
        <div class="metric-sub">Point-of-order demographic &amp; medical necessity check</div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     Enterprise Ecosystem & Compliance Badges
     ========================================================================== -->
<div class="trust-logos-strip">
  <div class="container">
    <div class="d-flex flex-wrap justify-content-center align-items-center gap-2">
      <span class="text-slate-500 small text-uppercase fw-bold me-2" style="font-size: 0.75rem; letter-spacing: 0.08em;">Universal EHR &amp; Analyzer Ecosystem:</span>
      <span class="trust-badge-pill"><i class="bi bi-hospital text-primary"></i> Epic Systems</span>
      <span class="trust-badge-pill"><i class="bi bi-heart-pulse text-danger"></i> Cerner / Oracle Health</span>
      <span class="trust-badge-pill"><i class="bi bi-dna text-purple" style="color: var(--purple);"></i> Illumina NovaSeq &amp; DRAGEN</span>
      <span class="trust-badge-pill"><i class="bi bi-droplet text-primary"></i> Roche Cobas &reg;</span>
      <span class="trust-badge-pill"><i class="bi bi-virus text-info"></i> Abbott Alinity</span>
      <span class="trust-badge-pill"><i class="bi bi-gear-wide-connected text-success"></i> Siemens Atellica</span>
      <span class="trust-badge-pill"><i class="bi bi-shield-lock text-dark"></i> HL7 FHIR R4 Ready</span>
    </div>
  </div>
</div>

<!-- ==========================================================================
     Specialized Laboratory Environments
     ========================================================================== -->
<section class="section-padding bg-white border-bottom">
  <div class="container">
    <div class="section-title-wrap">
      <span class="section-kicker">Multi-Disciplinary Scalability</span>
      <h2 class="section-title">Engineered for Complex Diagnostic Environments</h2>
      <p class="section-lead">
        From multi-facility hospital reference networks to specialized genomics sequencing centers and anatomical pathology practices.
      </p>
    </div>

    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
          <img src="https://images.unsplash.com/photo-1530026405186-ed1f139313f8?w=600&q=80&auto=format&fit=crop"
               alt="Clinical Chemistry and Hematology Automation Core"
               loading="lazy"
               style="height: 200px; object-fit: cover;">
          <div class="card-body p-4">
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-2">Hospital Core Labs</span>
            <h5 class="fw-bold mb-2">High-Throughput Clinical Chemistry</h5>
            <p class="small text-muted mb-3">
              Automated specimen sorting, bidirectional analyzer rack querying, and Westgard multi-rule QC with real-time autoverification.
            </p>
            <ul class="feature-check-list small mb-0">
              <li><i class="bi bi-check2"></i> Sub-second host query responses</li>
              <li><i class="bi bi-check2"></i> 365-day cumulative patient delta checks</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
          <img src="https://images.unsplash.com/photo-1579154341098-e4e158cc7f55?w=600&q=80&auto=format&fit=crop"
               alt="Genomics and Molecular Pathology Laboratory"
               loading="lazy"
               style="height: 200px; object-fit: cover;">
          <div class="card-body p-4">
            <span class="badge bg-purple-subtle text-purple border border-purple-subtle mb-2" style="color: var(--purple);">Genomics &amp; NGS</span>
            <h5 class="fw-bold mb-2">Molecular Diagnostics &amp; Next-Gen Sequencing</h5>
            <p class="small text-muted mb-3">
              Direct ingestion of FASTQ/BAM/VCF files from Illumina instruments with automated ACMG/AMP variant interpretation workflows.
            </p>
            <ul class="feature-check-list small mb-0">
              <li><i class="bi bi-check2"></i> DRAGEN bioinformatic pipeline sync</li>
              <li><i class="bi bi-check2"></i> Somatic and germline panel curation</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="col-lg-4 col-md-6">
        <div class="card h-100 border rounded-3 overflow-hidden shadow-sm">
          <img src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=600&q=80&auto=format&fit=crop"
               alt="Anatomic Pathology and Histology Laboratory"
               loading="lazy"
               style="height: 200px; object-fit: cover;">
          <div class="card-body p-4">
            <span class="badge bg-info-subtle text-info border border-info-subtle mb-2">Anatomic Pathology</span>
            <h5 class="fw-bold mb-2">Histology &amp; Synoptic Cancer Reporting</h5>
            <p class="small text-muted mb-3">
              Cassette and slide 2D barcoding, Whole Slide Imaging (WSI) viewer integration, and College of American Pathologists (CAP) protocols.
            </p>
            <ul class="feature-check-list small mb-0">
              <li><i class="bi bi-check2"></i> Synoptic CAP cancer checklists</li>
              <li><i class="bi bi-check2"></i> Multi-pathologist consensus review</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ==========================================================================
     Core Specialized Clinical Solutions
     ========================================================================== -->
<section class="section-padding">
  <div class="container">
    <div class="section-title-wrap">
      <span class="section-kicker">Platform Capabilities</span>
      <h2 class="section-title">Complete Diagnostic Platform Modules</h2>
      <p class="section-lead">
        Modular infrastructure designed to connect seamlessly with your existing hospital information systems and reference analyzers.
      </p>
    </div>

    <div class="row g-4">
      <% if (typeof solutions !== 'undefined' && solutions && solutions.length > 0) { %>
        <% solutions.forEach(sol => { %>
          <div class="col-lg-4 col-md-6">
            <div class="omni-card">
              <div class="card-icon-wrap">
                <i class="bi <%= sol.icon || 'bi-capsule' %>"></i>
              </div>
              <div class="badge bg-slate-100 text-slate-800 align-self-start mb-2 px-2 py-1 fw-semibold border" style="font-size: 0.75rem;">
                <%= sol.badgeText || sol.category %>
              </div>
              <h3 class="card-title"><%= sol.title %></h3>
              <p class="card-text"><%= sol.shortDesc %></p>

              <ul class="feature-check-list">
                <% (sol.keyFeatures || []).slice(0, 3).forEach(feat => { %>
                  <li>
                    <i class="bi bi-check-circle-fill"></i>
                    <span><%= feat %></span>
                  </li>
                <% }) %>
              </ul>

              <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                <a href="/solutions/<%= sol.slug %>" class="btn btn-sm btn-outline-omni">
                  Explore Architecture &rarr;
                </a>
                <button type="button" class="btn btn-sm btn-link text-primary text-decoration-none fw-semibold p-0" data-bs-toggle="modal" data-bs-target="#demoModal">
                  Book Demo
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-4">
          <div class="p-4 bg-white rounded border text-muted">
            <i class="bi bi-inbox fs-2 text-primary d-block mb-2"></i>
            <h5 class="fw-bold mb-1">Database Ready For Custom Solutions</h5>
            <p class="small text-muted mb-0">Dynamic module data can be populated via MongoDB administrative interface.</p>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ==========================================================================
     Interactive 4-Stage Diagnostic Workflow Architecture
     ========================================================================== -->
<section class="section-padding bg-slate-100 border-top border-bottom">
  <div class="container">
    <div class="section-title-wrap">
      <span class="section-kicker">Operating Lifecycle</span>
      <h2 class="section-title">The Complete Specimen Lifecycle</h2>
      <p class="section-lead">
        Replace disparate point software with a unified operational continuum across all 4 clinical phases.
      </p>
    </div>

    <!-- Nav tabs -->
    <div class="arch-tab-nav">
      <button class="arch-tab-btn active" data-target="phase1">
        <i class="bi bi-box-arrow-in-right"></i> 1. Pre-Analytical &amp; Intake
      </button>
      <button class="arch-tab-btn" data-target="phase2">
        <i class="bi bi-cpu"></i> 2. Analytical &amp; QC Engine
      </button>
      <button class="arch-tab-btn" data-target="phase3">
        <i class="bi bi-check2-all"></i> 3. Auto-Verification &amp; Signout
      </button>
      <button class="arch-tab-btn" data-target="phase4">
        <i class="bi bi-cash-stack"></i> 4. Front-End RCM Billing
      </button>
    </div>

    <!-- Tab Panels -->
    <div class="arch-showcase-box">
      <!-- Phase 1 -->
      <div class="arch-panel" id="phase1">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-primary text-white mb-2 px-3 py-1 font-mono small">PHASE 1 &bull; INTAKE &amp; ACCESSIONING</span>
            <h3 class="fw-bold mb-3">Positive Patient ID &amp; 2D DataMatrix Tracking</h3>
            <p class="text-muted mb-4">
              Prevent pre-analytical errors before tubes are uncapped. Electronic orders received via EHR (HL7 ORM / FHIR) or physician portals instantly generate 2D barcodes with real-time patient demographic and insurance eligibility verification.
            </p>
            <div class="row g-3">
              <div class="col-6">
                <div class="p-3 bg-slate-50 rounded border">
                  <div class="fw-bold text-primary"><i class="bi bi-phone me-1"></i> Mobile Phlebotomy</div>
                  <div class="small text-muted">Bedside wristband barcode verification</div>
                </div>
              </div>
              <div class="col-6">
                <div class="p-3 bg-slate-50 rounded border">
                  <div class="fw-bold text-teal" style="color: var(--secondary);"><i class="bi bi-truck me-1"></i> Courier Tracking</div>
                  <div class="small text-muted">Coolbox temperature and GPS transit telemetry</div>
                </div>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="terminal-box">
              <div class="d-flex justify-content-between text-slate-400 small mb-2 border-bottom border-slate-800 pb-2">
                <span>HL7 2.5.1 / FHIR Order Ingestion</span>
                <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>STREAM ACTIVE</span>
              </div>
              <pre class="m-0 text-cyan font-mono small" style="overflow-x: auto;">
MSH|^~\&|EPIC_EHR|METRO_HOSP|LISDESK|LAB_CORE|20261001123000||ORM^O01|MSG009812|P|2.5.1
PID|1||MRN984210^^^METRO||ANDERSON^JAMES^M||19820415|M
PV1|1|O|CLINIC_NORTH^^^ROOM102||||114920^DR_COLLINS
ORC|NW|ORD9021|||||^^^20261001123500|||20261001123000
OBR|1|ORD9021||80053^COMPREHENSIVE METABOLIC PANEL^CPT4|||20261001123200
&gt;&gt; [LISDESK Engine] 2D Barcode *CMP-984210* Generated &bull; Routing to Cobas 8000</pre>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 2 -->
      <div class="arch-panel d-none" id="phase2">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-info text-white mb-2 px-3 py-1 font-mono small">PHASE 2 &bull; ANALYZER DISPATCH &amp; QC</span>
            <h3 class="fw-bold mb-3">Sub-Second Host Query &amp; Multi-Rule Westgard QC</h3>
            <p class="text-muted mb-4">
              When an instrument scans a tube barcode, LISDESK responds in &lt; 30ms with test profiles, auto-dilution factors, and reflex rules. Levey-Jennings evaluations run continuously to lock out failing runs automatically.
            </p>
            <div class="d-flex flex-column gap-2">
              <div class="d-flex align-items-center gap-2 p-2 bg-slate-50 rounded border">
                <i class="bi bi-shield-check text-success fs-5"></i>
                <span class="small fw-semibold">Automatic instrument lockout when QC violates 1:3s or 2:2s Westgard rules</span>
              </div>
              <div class="d-flex align-items-center gap-2 p-2 bg-slate-50 rounded border">
                <i class="bi bi-arrow-repeat text-primary fs-5"></i>
                <span class="small fw-semibold">Rule-driven reflexing of critical values to confirmatory assays</span>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="p-4 bg-white rounded border shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0"><i class="bi bi-graph-up text-primary me-2"></i>Levey-Jennings QC Evaluation</h6>
                <span class="badge bg-success-subtle text-success border border-success-subtle">PASSED (All Rules)</span>
              </div>
              <div class="progress mb-2" style="height: 8px;">
                <div class="progress-bar bg-success" style="width: 80%"></div>
                <div class="progress-bar bg-warning" style="width: 20%"></div>
              </div>
              <div class="d-flex justify-content-between small text-muted mb-3 font-mono">
                <span>Analyte: Sodium (Na+)</span>
                <span>Mean: 140.2 mEq/L</span>
                <span>SD: &plusmn; 1.1</span>
              </div>
              <div class="p-2 bg-slate-50 rounded text-center small fw-semibold text-slate-700 border">
                <i class="bi bi-check-circle-fill text-success me-1"></i> Cobas 8000 &bull; Line 02 Active &amp; Verified
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Phase 3 -->
      <div class="arch-panel d-none" id="phase3">
        <div class="row align-items-center">
          <div class="col-lg-6 mb-4 mb-lg-0">
            <span class="badge bg-success text-white mb-2 px-3 py-1 font-mono small">PHASE 3 &bull; AUTO-VERIFICATION &amp; RELEASE</span>
            <h3 class="fw-bold mb-3">88%+ Auto-Verification with Multi-Year Delta History</h3>
            <p class="text-muted mb-4">
              Eliminate manual review bottlenecks on normal routine runs. LISDESK evaluates patient age, gender, historical baseline trends, and critical value thresholds in milliseconds, transmitting results directly to EHR charts.
            </p>
            <ul class="feature-check-list">
              <li><i class="bi bi-check-circle-fill"></i> Delta checks evaluated against 365-day patient baseline</li>
              <li><i class="bi bi-check-circle-fill"></i> College of American Pathologists (CAP) synoptic cancer reporting</li>
              <li><i class="bi bi-check-circle-fill"></i> Panic value alerts routed immediately to ordering physicians via SMS/email</li>
            </ul>
          </div>
          <div class="col-lg-6">
            <div class="p-3 bg-white rounded border shadow-sm">
              <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="fw-bold text-slate-900 small">Automated Cumulative Trend Check</span>
                <span class="badge bg-success font-mono">AUTO-RELEASED</span>
              </div>
              <div class="table-responsive">
                <table class="table table-sm table-bordered bg-white mb-0 small">
                  <thead class="table-light">
                    <tr>
                      <th>Analyte</th>
                      <th>Result</th>
                      <th>Ref Range</th>
                      <th>Delta Status</th>
                    </tr>
                  </thead>
                  <tbody>
