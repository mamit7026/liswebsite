          <div><i class="bi bi-lightning-charge text-primary me-1"></i> &lt; 5ms Auto-Verification</div>
          <div><i class="bi bi-check-all text-teal me-1" style="color: var(--secondary);"></i> 700+ Analyzers</div>
        </div>
      </div>

      <!-- Hero Visual: Real-time Live Engine Visualizer -->
      <div class="col-lg-6">
        <div class="hero-visual-card">
          <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
