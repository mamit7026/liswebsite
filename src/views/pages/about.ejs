<!-- Header -->
<div class="py-5 bg-light border-bottom" style="background-color: var(--bg-light) !important;">
  <div class="container py-4">
    <span class="badge bg-primary text-white mb-2 px-3 py-1">OUR MISSION &amp; HERITAGE</span>
    <h1 class="fw-bold mb-3 display-5">Pioneering the Future of Diagnostic Informatics</h1>
    <p class="lead text-muted mb-0" style="max-width: 720px;">
      Founded by clinical laboratory scientists and healthcare software engineers, LISDESK was created to replace obsolete legacy LIS software with a single modern, resilient LIMS operating platform.
    </p>
  </div>
</div>

<div class="section-padding">
