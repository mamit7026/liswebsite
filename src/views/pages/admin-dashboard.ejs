<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<!-- Admin Header -->
<div class="py-4 bg-dark text-white border-bottom">
  <div class="container d-flex flex-wrap justify-content-between align-items-center">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <span class="badge bg-secondary px-2 py-1"><i class="bi bi-shield-lock-fill me-1"></i>ADMIN CONSOLE</span>
        <h2 class="fw-bold mb-0 text-white fs-4">Informatics Lead &amp; Demonstration Manager</h2>
      </div>
      <div class="small text-muted">Real-time repository for incoming clinical lab demo bookings, contact dispatch, and subscriptions.</div>
    </div>
    <div class="d-flex align-items-center gap-3 mt-3 mt-md-0">
      <div class="p-2 px-3 rounded bg-black bg-opacity-50 border border-secondary border-opacity-25 small">
        <span class="text-muted">MongoDB:</span>
        <% if (stats.dbStatus && stats.dbStatus.connected) { %>
          <span class="badge bg-success ms-1"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i> Connected (<%= stats.dbStatus.name %>)</span>
        <% } else { %>
          <span class="badge bg-warning text-dark ms-1"><i class="bi bi-exclamation-circle me-1"></i> In-Memory Buffer Mode</span>
        <% } %>
      </div>
      <button class="btn btn-sm btn-outline-light" onclick="window.location.reload()">
        <i class="bi bi-arrow-clockwise me-1"></i> Refresh
      </button>
    </div>
  </div>
</div>

<div class="section-padding bg-light" style="background-color: var(--bg-light) !important;">
  <div class="container">
    
    <!-- Stats Cards -->
    <div class="row g-3 mb-4">
      <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 border shadow-sm">
          <div class="small text-muted fw-semibold">Total Demo Requests</div>
          <div class="fw-bold fs-3 text-primary"><%= stats.totalDemos %></div>
          <div class="small text-muted"><%= stats.newDemos %> Pending Action</div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 border shadow-sm">
          <div class="small text-muted fw-semibold">Scheduled Sessions</div>
          <div class="fw-bold fs-3 text-success"><%= stats.scheduledDemos %></div>
          <div class="small text-muted">Confirmed on calendar</div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 border shadow-sm">
          <div class="small text-muted fw-semibold">Support Inquiries</div>
          <div class="fw-bold fs-3 text-dark"><%= stats.totalContacts %></div>
          <div class="small text-muted"><%= stats.newContacts %> New messages</div>
        </div>
      </div>
      <div class="col-md-3 col-6">
        <div class="p-3 bg-white rounded-3 border shadow-sm">
          <div class="small text-muted fw-semibold">Newsletter Readers</div>
          <div class="fw-bold fs-3 text-teal" style="color: var(--secondary);"><%= stats.subscribers %></div>
          <div class="small text-muted">Active subscribers</div>
        </div>
      </div>
    </div>

    <!-- Demo Requests Table -->
    <div class="p-4 bg-white rounded-4 border shadow-sm mb-5">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0"><i class="bi bi-calendar-event text-primary me-2"></i>Laboratory Demo Requests (<%= demos.length %>)</h5>
        <span class="small text-muted">Change status dropdown to update lead state in real time</span>
      </div>

      <% if (!demos || demos.length === 0) { %>
        <div class="text-center py-5 text-muted">
          <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
          <div>No demo requests recorded yet.</div>
          <a href="/request-demo" class="btn btn-sm btn-primary-omni mt-2">Submit a Test Demo Request</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
              <tr>
                <th>Applicant / Organization</th>
                <th>Discipline &amp; Volume</th>
                <th>Timeframe &amp; Modules</th>
                <th>Notes / Specifics</th>
                <th>Received</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% demos.forEach(d => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= d.fullName %></div>
                    <div class="text-muted"><%= d.organization %></div>
                    <div class="small"><a href="mailto:<%= d.email %>" class="text-primary"><%= d.email %></a> &bull; <%= d.phone || 'No phone' %></div>
                  </td>
                  <td>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1"><%= d.labType %></span>
                    <div class="text-muted"><%= d.dailyTestVolume %></div>
                  </td>
                  <td>
                    <div class="fw-semibold text-dark"><%= d.timeframe %></div>
                    <div class="text-muted" style="font-size: 0.78rem;">
                      <%= (d.modulesOfInterest || []).join(', ') || 'General Overview' %>
                    </div>
                  </td>
                  <td>
                    <div class="text-truncate" style="max-width: 200px;" title="<%= d.notes %>">
                      <%= d.notes || '-' %>
                    </div>
                  </td>
                  <td>
                    <%= new Date(d.createdAt).toLocaleDateString() %><br>
                    <span class="text-muted" style="font-size: 0.75rem;"><%= new Date(d.createdAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) %></span>
                  </td>
                  <td>
                    <select class="form-select form-select-sm demo-status-select" data-id="<%= d._id %>" style="width: 140px;">
                      <option value="New" <%= d.status === 'New' ? 'selected' : '' %>>New</option>
                      <option value="Contacted" <%= d.status === 'Contacted' ? 'selected' : '' %>>Contacted</option>
                      <option value="Scheduled" <%= d.status === 'Scheduled' ? 'selected' : '' %>>Scheduled</option>
                      <option value="Demo Delivered" <%= d.status === 'Demo Delivered' ? 'selected' : '' %>>Delivered</option>
                      <option value="Closed" <%= d.status === 'Closed' ? 'selected' : '' %>>Closed</option>
                    </select>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- Contact Inquiries Table -->
    <div class="p-4 bg-white rounded-4 border shadow-sm">
      <h5 class="fw-bold mb-3"><i class="bi bi-chat-left-dots text-teal me-2" style="color: var(--secondary);"></i>General Contact Messages (<%= contacts.length %>)</h5>
      
      <% if (!contacts || contacts.length === 0) { %>
        <div class="text-center py-4 text-muted small">
          No contact inquiries recorded yet.
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle small mb-0">
            <thead class="table-light">
              <tr>
                <th>Sender &amp; Org</th>
                <th>Department</th>
                <th>Subject</th>
                <th>Message Content</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% contacts.forEach(c => { %>
                <tr>
                  <td>
                    <div class="fw-bold text-dark"><%= c.name %></div>
                    <div class="text-muted"><%= c.company %></div>
                    <a href="mailto:<%= c.email %>" class="text-primary"><%= c.email %></a>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border"><%= c.department %></span>
                  </td>
                  <td class="fw-semibold text-dark"><%= c.subject %></td>
                  <td>
                    <div style="max-width: 280px;"><%= c.message %></div>
                  </td>
                  <td><%= new Date(c.createdAt).toLocaleDateString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
